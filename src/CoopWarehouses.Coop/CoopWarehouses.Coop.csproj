<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>CoopWarehouses.Coop</AssemblyName>
    <RootNamespace>CoopWarehouses.Coop</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Not a submodule: loaded by CoopWarehouses once Coop's assemblies are in the process. -->
    <OutputPath>..\CoopWarehouses\_Module\bin\Win64_Shipping_Client\</OutputPath>
    <CoopRefDir Condition="'$(CoopRefDir)' == ''">D:\Program Files (x86)\Steam\steamapps\workshop\content\261550\3770450698\bin\Win64_Shipping_Client</CoopRefDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" ExcludeAssets="runtime" />
    <ProjectReference Include="..\CoopWarehouses\CoopWarehouses.csproj" Private="false" />
    <Reference Include="Common" HintPath="$(CoopRefDir)\Common.dll" Private="false" />
    <Reference Include="Coop.Core" HintPath="$(CoopRefDir)\Coop.Core.dll" Private="false" />
    <Reference Include="GameInterface" HintPath="$(CoopRefDir)\GameInterface.dll" Private="false" />
    <Reference Include="LiteNetLib" HintPath="$(CoopRefDir)\LiteNetLib.dll" Private="false" />
    <Reference Include="protobuf-net" HintPath="$(CoopRefDir)\protobuf-net.dll" Private="false" />
    <Reference Include="protobuf-net.Core" HintPath="$(CoopRefDir)\protobuf-net.Core.dll" Private="false" />
    <Reference Include="Autofac" HintPath="$(CoopRefDir)\Autofac.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyServerBin" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb" DestinationFolder="..\CoopWarehouses\_Module\bin\Win64_Shipping_Server\" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
